# Copy to .env and adjust. .env is gitignored. No secret ever goes here (spec 0003):
# passwords and keys are files in SECRETS_DIR, created by scripts/dev-secrets.sh on the laptop.
# Compose reads this file for ${VAR} substitution only. A variable reaches a service
# only once it is listed under that service's environment in compose.yaml.

# demo or live. Every process refuses to start if unset or unknown.
TRADING_ENV=demo

# dev on the laptop (adds pytest to the images), runtime on the VPS.
IMAGE_TARGET=dev

LOG_LEVEL=INFO

# Host folder of the secret files, used only for Compose substitution (no service sees it).
# Laptop: ./secrets (the default). VPS: /etc/kfs/secrets (see docs/specs/0003-api-keys-secrets/verify.md).
# SECRETS_DIR=./secrets

POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

# Startup clock check (SNTP). Offset limit in milliseconds.
CLOCK_SERVERS=0.pool.ntp.org,1.pool.ntp.org,2.pool.ntp.org
MAX_CLOCK_OFFSET_MS=250

# USD margined BTC and ETH perps, pinned from the Kraken instrument provider (live public data).
RECORDER_INSTRUMENTS=PF_XBTUSD.KRAKEN,PF_ETHUSD.KRAKEN

# Host port for the dashboard, bound to 127.0.0.1 only.
DASHBOARD_HOST_PORT=8000

# Dashboard login and live values (spec 0004). Secure cookies by default; set false only in
# demo when your laptop browser refuses a Secure cookie on http://127.0.0.1.
# DASHBOARD_COOKIE_SECURE=true
# DASHBOARD_STALE_AMBER_S=3
# DASHBOARD_STALE_RED_S=10
# DASHBOARD_POLL_MS=500
# DASHBOARD_SESSION_IDLE_H=24
# DASHBOARD_SESSION_MAX_D=7
# CONTROL_COMMAND_TTL_S=300
# DASHBOARD_COMMAND_HIDE_S=900
# DASHBOARD_ACK_WARN_S=10
