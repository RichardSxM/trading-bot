# Copy to .env and adjust. .env is gitignored. No secret ever goes here (spec 0003):
# passwords and keys are files in SECRETS_DIR, created by scripts/dev-secrets.sh on the laptop.
# Compose reads this file for ${VAR} substitution only. A variable reaches a service
# only once it is listed under that service's environment in compose.yaml.

# demo or live. Every process refuses to start if unset or unknown.
TRADING_ENV=demo

# dev on the laptop (adds pytest to the images), runtime on the VPS.
IMAGE_TARGET=dev

# Image name prefix (spec 0005). Laptop: kfs/ (the default, local builds). The VPS sets
# ghcr.io/richardsxm/kfs- in /etc/kfs/kfs.env (deploy/kfs.env.example). KFS_TAG is set only by
# the VPS deploy scripts, never here.
# KFS_IMAGE_PREFIX=kfs/

# Recorder refuses to start without the extra disk's marker file. VPS only (compose.vps.yaml).
# CATALOG_REQUIRE_MARKER=false

# Catalog disk limits (spec 0007). Retention keeps the free floor and the 30 GB cap on Parquet;
# below the hard floor the recorder stops. The hard floor must be below the free floor.
# CATALOG_FREE_FLOOR_GB=8
# CATALOG_HARD_FLOOR_GB=2
# CATALOG_CAP_GB=30

LOG_LEVEL=INFO

# The UTC date the total loss limit counts from (spec 0010). No default: the trader refuses to
# start without it. A later date forgives the losses before it.
RISK_TOTAL_LOSS_SINCE=2026-10-12

# Host folder of the secret files, used only for Compose substitution (no service sees it).
# Laptop: ./secrets (the default). VPS: /etc/kfs/secrets (see docs/specs/0003-api-keys-secrets/verify.md).
# SECRETS_DIR=./secrets

POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

# Laptop only: starts the `clock` service, which keeps the Docker Desktop VM clock synced
# (it drifts while the Mac sleeps). Never set this on the VPS.
COMPOSE_PROFILES=laptop

# Startup clock check (SNTP). Offset limit in milliseconds.
CLOCK_SERVERS=0.pool.ntp.org,1.pool.ntp.org,2.pool.ntp.org
MAX_CLOCK_OFFSET_MS=250

# The USD margined BTC perp, pinned from the Kraken instrument provider (live public data). BTC only
# since 2026-10-08: recording ETH too overloaded the 2 CPU VPS; backtests use free Tardis days.
RECORDER_INSTRUMENTS=PF_XBTUSD.KRAKEN

# Backups (spec 0005 AC-19). Left unset, the laptop uses a local restic repository in the
# backup-staging volume; create it once (see docs/specs/0005-always-on-cloud-deployment/verify.md).
# The VPS sets b2:<bucket>:kfs in /etc/kfs/kfs.env. Run time is HH:MM UTC.
# RESTIC_REPOSITORY=/staging/restic-repo
# BACKUP_AT_UTC=02:30
# BACKUP_STALE_H=26

# The laptop fetch of catalog days from B2 (spec 0007 AC-10): scripts/fetch-catalog.sh. Separate
# from RESTIC_REPOSITORY above, which is the laptop's own local repository. It reads the B2 restic
# password and a read only B2 key (listBuckets, listFiles, readFiles on this bucket) from
# secrets/b2/restic_password, secrets/b2/read_key_id, and secrets/b2/read_application_key.
# CATALOG_RESTIC_REPOSITORY=b2:<bucket>:kfs

# Host port for the dashboard, bound to 127.0.0.1 only.
DASHBOARD_HOST_PORT=8000

# Dashboard login and live values (spec 0004). Secure cookies by default; set false only in
# demo when your laptop browser refuses a Secure cookie on http://127.0.0.1.
# DASHBOARD_COOKIE_SECURE=true
# DASHBOARD_STALE_AMBER_S=3
# DASHBOARD_STALE_RED_S=10
# DASHBOARD_POLL_MS=500
# DASHBOARD_SESSION_IDLE_H=24
# DASHBOARD_SESSION_MAX_D=7
# CONTROL_COMMAND_TTL_S=300
# DASHBOARD_COMMAND_HIDE_S=900
# DASHBOARD_ACK_WARN_S=10

# Phone alerts (spec 0013). The laptop stays on log: a dry run that logs each push as
# alert_dry_run, sends nothing, and pings nothing. Only the VPS sets pushover.
# ALERTS_DELIVERY=log
# ALERTS_TRADER_DOWN_S=45
# ALERTS_HOURLY_CAP=30
# ALERTS_RENOTIFY_S=3600
# ALERTS_CRITICAL_RENOTIFY_S=14400
# ALERTS_ENTRY_BLOCK_S=3600
# ALERTS_DISK_FREE_GB=5
# ALERTS_DAILY_AT=08:00
# ALERTS_DAILY_TZ=Europe/Amsterdam
