# The VPS env file (spec 0005). bootstrap.sh copies it to /etc/kfs/kfs.env (root, 0644) when
# that file is missing, and never overwrites it afterwards. kfs-compose passes it to every
# Compose call with --env-file. Same rules as the laptop's .env: no secret ever goes here
# (secrets are files in /etc/kfs/secrets), and a variable reaches a service only through
# compose.yaml. KFS_TAG is set by kfs-compose and kfs-deploy, never here.

# demo until feature 19. kfs-compose adds compose.live.yaml exactly when this says live.
TRADING_ENV=demo

IMAGE_TARGET=runtime
KFS_IMAGE_PREFIX=ghcr.io/richardsxm/kfs-
SECRETS_DIR=/etc/kfs/secrets

LOG_LEVEL=INFO

# The UTC date the total loss limit counts from (spec 0010). No default: the trader refuses to
# start without it. Add it to an existing /etc/kfs/kfs.env by hand, bootstrap never overwrites it.
RISK_TOTAL_LOSS_SINCE=2026-10-12

POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

CLOCK_SERVERS=0.pool.ntp.org,1.pool.ntp.org,2.pool.ntp.org
MAX_CLOCK_OFFSET_MS=250

RECORDER_INSTRUMENTS=PF_XBTUSD.KRAKEN

# The coins the paper strategy trades (spec 0025 AC-15), comma separated, any order. Optional:
# compose defaults it to PF_XBTUSD.KRAKEN. More than one coin needs PAPER_STRATEGY=donchian_scalp_r1
# or donchian_scalp_r2, and the set is part of the version, so a new set needs its own manual promote
# before the deploy. The r2 demo set is the 9 coins that passed the spec 0026 AC-19 quote gap check.
# A coin whose stored instrument row differs from the venue (a tick size change, say) blocks entries
# with record_conflict until that row is updated by hand.
# PAPER_INSTRUMENTS=PF_XBTUSD.KRAKEN,PF_ETHUSD.KRAKEN,PF_SOLUSD.KRAKEN,PF_XRPUSD.KRAKEN,PF_LINKUSD.KRAKEN,PF_UNIUSD.KRAKEN,PF_ZECUSD.KRAKEN,PF_DOGEUSD.KRAKEN,PF_QNTUSD.KRAKEN

# 127.0.0.1 only; `tailscale serve` exposes it on https://kfs-vps.<tailnet>.ts.net.
DASHBOARD_HOST_PORT=8000
DASHBOARD_COOKIE_SECURE=true

# Backups (spec 0005 milestone 4). b2:<bucket>:kfs
RESTIC_REPOSITORY=
BACKUP_AT_UTC=02:30
BACKUP_STALE_H=26

# Phone alerts (spec 0013). Required: compose.vps.yaml has no default, so the deploy refuses
# without this line. Needs the pushover_app_token, pushover_user_key, and hc_alerter_url secrets.
ALERTS_DELIVERY=pushover

# Live only (feature 19): the UTC date the Kraken key was created.
# KRAKEN_KEY_ROTATED_ON=
