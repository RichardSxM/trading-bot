#!/usr/bin/env bash
# The VPS half of a deploy (spec 0005 AC-4, AC-12). Linked as /usr/local/sbin/kfs-deploy;
# scripts/deploy.sh on the laptop drives it over Tailscale SSH:
#
#   sudo kfs-deploy receive <sha>    # unpack a release bundle (tar on stdin) into /opt/kfs/releases/<sha>
#   sudo kfs-deploy run <sha> [--wait 15m] [--now]
#                                    # preflight, pull, pause and wait for flat, switch, up,
#                                    # health gate, rollback if unhealthy, unpause, deploy log
#   sudo kfs-deploy link-host        # relink /usr/local/sbin/kfs-* and units (bootstrap uses it)
#
# Exit codes of `run`: 0 deployed, 1 rolled back or rollback failed, 2 aborted with nothing
# switched (not flat, pause lifted, pause failed, no trader_state), 3 another deploy holds the
# lock, 4 refused before anything changed (preflight or pull).
#
# --wait sets how long to wait for flat (90s, 15m, 1h; default 15m). --now sends the pause but
# skips the wait, and goes on when the trader cannot confirm it (an old release, say); the
# restart then relies on the exchange side stops.
set -euo pipefail

KFS_PROCESS=kfs-deploy
HOST_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=deploy/host/lib.sh
. "$HOST_DIR/lib.sh"

RELEASES="$KFS_ROOT/releases"
DEPLOY_LOG="$KFS_LOG_DIR/deploys.jsonl"
LOCK=/run/lock/kfs-deploy.lock
HEALTH_TIMEOUT_S=180
MIN_FREE_BYTES=5000000000
KEEP_RELEASES=3

die() {
    local code=$1
    shift
    kfs_log ERROR "$*" >&2
    exit "$code"
}

usage() {
    sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 64
}

[ "$(id -u)" -eq 0 ] || die 1 "run as root (sudo kfs-deploy ...)"

receive() {
    local sha=$1 tmp
    kfs_is_sha "$sha" || die 64 "not a full commit sha: $sha"
    mkdir -p "$RELEASES"
    tmp=$(mktemp -d "$RELEASES/.incoming.XXXXXX")
    if ! tar -x -C "$tmp" --no-same-owner; then
        rm -rf "$tmp"
        die 4 "release bundle did not unpack"
    fi
    if [ ! -f "$tmp/compose.yaml" ] || [ ! -x "$tmp/deploy/host/kfs-deploy" ]; then
        rm -rf "$tmp"
        die 4 "release bundle lacks compose.yaml or deploy/host/kfs-deploy"
    fi
    chmod 0755 "$tmp"
    rm -rf "${RELEASES:?}/$sha"
    mv "$tmp" "$RELEASES/$sha"
    kfs_log INFO "release received" sha "$sha"
}

# Compose with the new release's kfs-compose, bundle, and image tag.
compose_new() {
    KFS_RELEASE=$SHA "$RELEASES/$SHA/deploy/host/kfs-compose" "$@"
}

# Compose for the running stack (after the switch it is the new release).
compose_current() {
    "$KFS_ROOT/current/deploy/host/kfs-compose" "$@"
}

record() {
    local outcome=$1
    mkdir -p "$KFS_LOG_DIR"
    jq -nc --arg sha "$SHA" --arg previous_sha "$PREVIOUS_SHA" --arg started_at "$STARTED_AT" \
        --arg finished_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg outcome "$outcome" \
        --arg paused "$KFS_PAUSED_BY_US" --argjson waited "$KFS_WAITED_S" \
        '{sha: $sha, previous_sha: (if $previous_sha == "" then null else $previous_sha end),
          started_at: $started_at, finished_at: $finished_at, outcome: $outcome,
          paused_by_deploy: ($paused == "true"), waited_for_flat_s: $waited}' >>"$DEPLOY_LOG"
    printf 'deploy %s: %s (previous %s) in %ss\n' "$outcome" "${SHA:0:12}" "${PREVIOUS_SHA:0:12}" "$((SECONDS - START_S))"
}

refuse() {
    kfs_log ERROR "preflight refused" reason "$1"
    record preflight_refused
    exit 4
}

preflight() {
    local path avail name images img
    for path in / /srv/kfs; do
        avail=$(df -B1 --output=avail "$path" | tail -n 1 | tr -d ' ')
        [ "$avail" -ge "$MIN_FREE_BYTES" ] || refuse "under 5 GB free on $path"
    done
    while read -r name; do
        [ -s "$KFS_SECRETS_DIR/$name" ] || refuse "secret file $name missing or empty"
    done < <(kfs_secret_names "$RELEASES/$SHA")
    [ -s "$KFS_SECRETS_DIR/ghcr_token" ] || refuse "secret file ghcr_token missing"
    # A nightly backup in progress: deploy again after it logs `backup done` (AC-12). Only an
    # answer of yes counts; no backup container (the first deploy) or the stub image is a no.
    if [ -n "$PREVIOUS_SHA" ] && compose_current exec -T backup test -e /staging/running >/dev/null 2>&1; then
        refuse "a backup is running; deploy again after it logs backup done"
    fi
    # Every image this release runs that is tagged with the commit, i.e. built by CI.
    images=$(compose_new config --images | grep ":$SHA\$" || true)
    [ -n "$images" ] || refuse "no image tagged $SHA in the Compose config (check KFS_IMAGE_PREFIX)"
    for img in $images; do
        # Uses the VPS's own GHCR login, so a failed login also lands here.
        docker manifest inspect "$img" >/dev/null 2>&1 || refuse "image $img missing, or ghcr.io login failed"
    done
    kfs_log INFO "preflight passed" sha "$SHA" images "$(echo "$images" | wc -l | tr -d ' ')"
}

abort() {
    local outcome=$1 reason=$2
    kfs_log ERROR "deploy aborted" outcome "$outcome" reason "$reason"
    record "$outcome"
    exit 2
}

# Pause entries and wait until the trader holds no position and no entry order (AC-8). The
# control CLI comes from the new release (KFS_CONTROL_RELEASE), which has it even when the
# running release predates it.
drain() {
    local rc=0
    kfs_pause_and_wait "$NOW" "$WAIT" || rc=$?
    case $rc in
        0) ;;
        "$KFS_DRAIN_PAUSE_FAILED") abort aborted_pause_failed "$KFS_DRAIN_REASON" ;;
        "$KFS_DRAIN_PAUSE_LIFTED") abort aborted_pause_lifted "$KFS_DRAIN_REASON" ;;
        "$KFS_DRAIN_NOT_FLAT") abort aborted_not_flat "$KFS_DRAIN_REASON" ;;
        *) abort aborted_no_trader_state "$KFS_DRAIN_REASON" ;;
    esac
}

switch_release() {
    local target=$1
    ln -sfn "releases/$target" "$KFS_ROOT/current.new"
    mv -T "$KFS_ROOT/current.new" "$KFS_ROOT/current"
    kfs_link_host | while read -r line; do kfs_log INFO "host link" change "$line"; done
    kfs_log INFO "current switched" sha "$target"
}

# 0 when the trader's snapshot (`trader_state`, or `heartbeat` with --heartbeat for a release
# from before spec 0005) is fresh and carries commit $1.
trader_matches() {
    local expect=$1 snapshot=${2:-state} line commit
    line=$(kfs_control "$snapshot" 2>/dev/null) || {
        echo "trader $snapshot: ${line:-unreadable}"
        return 1
    }
    commit=$(jq -r '.data.git_commit // ""' <<<"$line")
    if [ "$commit" != "$expect" ]; then
        echo "trader $snapshot git_commit ${commit:-none}"
        return 1
    fi
}

# health_gate <sha> [state|heartbeat]
health_gate() {
    local expect=$1 snapshot=${2:-state} deadline=$((SECONDS + HEALTH_TIMEOUT_S)) why=""
    while [ "$SECONDS" -lt "$deadline" ]; do
        if why=$(kfs_services_healthy) && why=$(trader_matches "$expect" "$snapshot"); then
            kfs_log INFO "health gate passed" sha "$expect" after_s "$((SECONDS - START_S))"
            return 0
        fi
        sleep 2
    done
    kfs_log ERROR "health gate failed" sha "$expect" reason "$why"
    return 1
}

# Back to the previous release (AC-10): its images are still local, migrations stay applied.
rollback() {
    compose_current ps -a >&2 || true
    if [ -z "$PREVIOUS_SHA" ] || [ "$PREVIOUS_SHA" = "$SHA" ] || [ ! -d "$RELEASES/$PREVIOUS_SHA" ]; then
        kfs_log CRITICAL "no previous release to roll back to" sha "$SHA" previous_sha "$PREVIOUS_SHA"
        record rollback_failed
        exit 1
    fi
    kfs_log ERROR "rolling back" sha "$SHA" previous_sha "$PREVIOUS_SHA"
    switch_release "$PREVIOUS_SHA"
    # A release from before spec 0005 writes no trader_state, only the heartbeat.
    if compose_current up -d --no-build --pull never --remove-orphans &&
        { health_gate "$PREVIOUS_SHA" state || health_gate "$PREVIOUS_SHA" heartbeat; }; then
        record rolled_back
        kfs_unpause_if_ours
        exit 1
    fi
    # Stays paused (if this deploy paused): nothing healthy is trading now.
    kfs_log CRITICAL "rollback failed" sha "$SHA" previous_sha "$PREVIOUS_SHA"
    record rollback_failed
    exit 1
}

# Keep the current release and the two before it (from the deploy log), folders and images.
prune() {
    local keep name repos repo tag
    keep=$(
        {
            echo "$SHA"
            [ -n "$PREVIOUS_SHA" ] && echo "$PREVIOUS_SHA"
            # Newest first, each deploy's sha then the release it replaced, so a redeploy of the
            # same sha (previous_sha == sha) never hides the release before it.
            jq -r 'select(.outcome == "deployed") | .sha, (.previous_sha // "")' "$DEPLOY_LOG" 2>/dev/null |
                paste - - | tac | tr '\t' '\n'
        } | awk 'NF && !seen[$0]++' | head -n "$KEEP_RELEASES"
    )
    # Explicit ifs: under set -e a loop whose last command failed would end the script.
    for dir in "$RELEASES"/*; do
        name=$(basename "$dir")
        if kfs_is_sha "$name" && ! grep -qx "$name" <<<"$keep"; then
            rm -rf "${RELEASES:?}/$name"
            kfs_log INFO "release pruned" sha "$name"
        fi
    done
    repos=$(compose_current config --images | grep ":$SHA\$" | sed 's/:[^:]*$//' || true)
    for repo in $repos; do
        while read -r tag; do
            if kfs_is_sha "$tag" && ! grep -qx "$tag" <<<"$keep"; then
                if docker image rm "$repo:$tag" >/dev/null 2>&1; then
                    kfs_log INFO "image pruned" image "$repo:$tag"
                else
                    kfs_log WARNING "image prune failed" image "$repo:$tag"
                fi
            fi
        done < <(docker image ls "$repo" --format '{{.Tag}}')
    done
}

run() {
    SHA=$1
    shift
    local args=("$@")
    WAIT=15m
    NOW=false
    while [ $# -gt 0 ]; do
        case $1 in
            --wait)
                [ $# -ge 2 ] || usage
                [[ $2 =~ ^[0-9]+[smh]?$ ]] || die 64 "--wait needs a duration such as 90s, 15m, or 1h"
                WAIT=$2
                shift 2
                ;;
            --now)
                NOW=true
                shift
                ;;
            *) die 64 "unknown option $1" ;;
        esac
    done
    kfs_is_sha "$SHA" || die 64 "not a full commit sha: $SHA"
    local bundle="$RELEASES/$SHA/deploy/host/kfs-deploy"
    [ -x "$bundle" ] || die 4 "no release bundle for $SHA (run receive first)"
    # Run the new release's own copy, so a changed deploy script takes effect at once.
    if [ "$(readlink -f "$0")" != "$(readlink -f "$bundle")" ]; then
        exec "$bundle" run "$SHA" ${args[@]+"${args[@]}"}
    fi

    exec 9>"$LOCK"
    flock -n 9 || die 3 "deploy in progress"

    START_S=$SECONDS
    STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    PREVIOUS_SHA=$(kfs_current_sha)
    KFS_CONTROL_RELEASE=$SHA
    kfs_log INFO "deploy started" sha "$SHA" previous_sha "$PREVIOUS_SHA" wait "$WAIT" now "$NOW"

    preflight
    if ! compose_new pull --quiet; then
        refuse "image pull failed"
    fi
    kfs_log INFO "images pulled" sha "$SHA"

    # Every deploy recreates the trader, so it drains first. The first deploy has no trader yet.
    if [ -n "$PREVIOUS_SHA" ]; then
        drain
    fi

    switch_release "$SHA"
    if compose_current up -d --no-build --pull never --remove-orphans && health_gate "$SHA"; then
        kfs_unpause_if_ours
        record deployed
        prune
        exit 0
    fi
    rollback
}

case "${1:-}" in
    receive)
        [ $# -eq 2 ] || usage
        receive "$2"
        ;;
    run)
        [ $# -ge 2 ] || usage
        shift
        run "$@"
        ;;
    link-host)
        kfs_link_host
        ;;
    *) usage ;;
esac
