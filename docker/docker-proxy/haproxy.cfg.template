# The alerter's door to Docker (spec 0013, *Security model*), mounted over the image's own
# template (tecnativa/docker-socket-proxy v0.5.0). The image's CONTAINERS=1 allows every GET
# under /containers, archive and export included, which would read other containers' files
# (their secrets among them). This allows exactly the three calls the alerter makes:
#   GET /containers/json              the project's containers
#   GET /containers/<id>/json         inspect (project label, start time)
#   GET /containers/<id>/logs         log lines
# and denies everything else, every other method included. The entrypoint fills in BIND_CONFIG.
global
    log stdout format raw daemon "${LOG_LEVEL}"
    pidfile /run/haproxy.pid
    maxconn 4000

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option http-server-close
    timeout http-request 10s
    timeout queue 1m
    timeout connect 10s
    timeout client 10m
    timeout server 10m
    timeout http-keep-alive 10s
    maxconn 3000
    errorfile 400 /usr/local/etc/haproxy/errors/400.http
    errorfile 403 /usr/local/etc/haproxy/errors/403.http
    errorfile 408 /usr/local/etc/haproxy/errors/408.http
    errorfile 500 /usr/local/etc/haproxy/errors/500.http
    errorfile 502 /usr/local/etc/haproxy/errors/502.http
    errorfile 503 /usr/local/etc/haproxy/errors/503.http
    errorfile 504 /usr/local/etc/haproxy/errors/504.http

backend dockerbackend
    server dockersocket $SOCKET_PATH

frontend dockerfrontend
    bind ${BIND_CONFIG}
    http-request deny unless METH_GET
    # Anchored at both ends, with one path segment for the id that cannot start with a dot, so
    # neither a longer path nor a `..` slips through.
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/json$ }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/[a-zA-Z0-9][a-zA-Z0-9_.-]*/(json|logs)$ }
    http-request deny
    default_backend dockerbackend
